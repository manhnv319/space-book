  "edges": [
    {
      "id": "pr-ci",
      "from": "pull_request",
      "to": "ci",
      "label": "open PR",
      "role": "main",
      "variant": "emphasis"
    },
    {
      "id": "ci-merge",
      "from": "ci",
      "to": "merge_main",
      "label": "CI green",
      "role": "main"
    },
    {
      "id": "merge-build",
      "from": "merge_main",
      "to": "build_push",
      "label": "push to main",
      "role": "main"
    },
    {
      "id": "build-deploy",
      "from": "build_push",
      "to": "vps_deploy",
      "label": "images ready",
      "role": "main",
      "variant": "security"
    },
    {
      "id": "deploy-health",
      "from": "vps_deploy",
      "to": "health_check",
      "label": "rolling up",
      "role": "main",
      "variant": "emphasis"
    }
