{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "Space Book Production Deployment Gate",
    "subtitle": "Continuous integration gate protects main; automated CD delivers container images via Tailscale to VPS",
    "output": "ci-cd.workflow.html",
    "quality_profile": "showcase",
    "views": [
      {
        "id": "release-path",
        "label": "PR to production",
        "focus": ["pull_request", "ci", "merge_main", "build_push", "vps_deploy", "health_check"],
        "note": "Follow code from PR validation to containerized rollout on the VPS host."
      },
      {
        "id": "quality-gate",
        "label": "Automated verification gate",
        "focus": ["ci", "merge_main"],
        "note": "Frontend Vitest and Backend ArchUnit / Mongo RS election must pass before merge."
      }
    ]
  },
  "lanes": [
    { "id": "engineering", "label": "Engineering" },
    { "id": "github", "label": "GitHub Actions" },
    { "id": "ghcr", "label": "GitHub Registry" },
    { "id": "vps", "label": "VPS Production" }
  ],
  "phases": [
    { "id": "change", "label": "Change", "fromCol": 0, "toCol": 0 },
    { "id": "quality", "label": "Quality gate", "fromCol": 1, "toCol": 1, "variant": "emphasis" },
    { "id": "package", "label": "Container packaging", "fromCol": 2, "toCol": 3 },
    { "id": "deploy", "label": "VPS deployment", "fromCol": 4, "toCol": 5, "variant": "security" }
  ],
  "mainPath": ["pull_request", "ci", "merge_main", "build_push", "vps_deploy", "health_check"],
  "nodes": [
    {
      "id": "pull_request",
      "lane": "engineering",
      "col": 0,
      "type": "external",
      "label": "Pull Request",
      "sublabel": "feature branch to main",
      "width": 140
    },
    {
      "id": "ci",
      "lane": "github",
      "col": 1,
      "type": "backend",
      "label": "CI Pipeline",
      "sublabel": "lint, types, vitest, archunit",
      "tag": "green gate",
      "width": 148
    },
    {
      "id": "merge_main",
      "lane": "engineering",
      "col": 2,
      "type": "security",
      "label": "Merge to Main",
      "sublabel": "squash or rebase to main",
      "width": 140
    },
    {
      "id": "build_push",
      "lane": "ghcr",
      "col": 3,
      "type": "cloud",
      "label": "Build & Push",
      "sublabel": "multi-stage images to GHCR",
      "width": 148
    },
    {
      "id": "vps_deploy",
      "lane": "vps",
      "col": 4,
      "type": "cloud",
      "label": "Tailscale Deploy",
      "sublabel": "SSH & Docker rolling update",
      "width": 154
    },
    {
      "id": "health_check",
      "lane": "vps",
      "col": 5,
      "type": "backend",
      "label": "Service Ready",
      "sublabel": "healthcheck & RS election",
      "width": 148
    }
